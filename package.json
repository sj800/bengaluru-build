{
  "name": "bengaluru-build",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "framer-motion": "^12.36.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet": "^6.1.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "react-snap": "^1.23.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env CI=false react-scripts build && react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && wrangler deploy"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "chrome 64"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "puppeteer": "^24.40.0",
    "wrangler": "^4.73.0"
  },
  "reactSnap": {
    "include": [
      "/",
      "/about",
      "/pricing",
      "/contact",
      "/choose-your-template",
      "/templates/student-profile",
      "/templates/professional-profile",
      "/templates/professional-profile-umbra",
      "/templates/hotel-brick"
    ],
    "skipThirdPartyRequests": true,
    "async": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  }
}
